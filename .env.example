# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/grade_management"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="grade_management"
DATABASE_USER="your_db_user"
DATABASE_PASSWORD="your_secure_db_password"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Encryption Configuration
ENCRYPTION_KEY="your-32-character-encryption-key-here" # Must be exactly 32 characters

# API Configuration
API_BASE_URL="http://localhost:3000/api"
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS_ADMIN="1000"
RATE_LIMIT_MAX_REQUESTS_TEACHER="500"
RATE_LIMIT_MAX_REQUESTS_STUDENT="100"

# Security Headers
ENABLE_STRICT_TRANSPORT_SECURITY="true"
ENABLE_CONTENT_SECURITY_POLICY="true"

# Logging
LOG_LEVEL="info" # debug, info, warn, error
LOG_FILE_PATH="./logs/app.log"
ENABLE_AUDIT_LOGGING="true"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="noreply@yourdomain.com"

# File Upload Configuration
MAX_FILE_SIZE="10485760" # 10MB
ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx"

# Session Configuration
SESSION_SECRET="your-session-secret-key"
SESSION_MAX_AGE="86400000" # 24 hours

# Development/Production
NODE_ENV="development" # development, production
PORT="3000"

# Redis Configuration (for rate limiting and sessions in production)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Monitoring and Analytics
ENABLE_PERFORMANCE_MONITORING="false"
SENTRY_DSN="" # For error tracking in production
