# Frontend Environment Configuration for Hugging Face Spaces

# API Configuration
NEXT_PUBLIC_API_URL=https://scoreaimanage.onrender.com/api
NEXT_PUBLIC_APP_URL=https://huggingface.co/spaces/StephenZao/scoreaimanage

# Application Configuration
NEXT_PUBLIC_APP_NAME=ScoreAIManage
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=学生成绩管理系统

# Environment
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# UI Configuration
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_LANGUAGE=zh-CN
