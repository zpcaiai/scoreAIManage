# Production Environment Configuration for Render

# Database Configuration (PostgreSQL)
DATABASE_HOST=your-postgres-host.render.com
DATABASE_PORT=5432
DATABASE_NAME=scoremanage
DATABASE_USER=scoremanage_user
DATABASE_PASSWORD=your-secure-password
DATABASE_URL=postgresql://scoremanage_user:your-secure-password@your-postgres-host.render.com:5432/scoremanage
DATABASE_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-for-production-change-this
JWT_EXPIRES_IN=24h

# Encryption Configuration
ENCRYPTION_KEY=your-32-character-encryption-key-here

# API Configuration
API_BASE_URL=https://scoreaimanage.onrender.com/api
ALLOWED_ORIGINS=https://scoreaimanage.onrender.com,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_ADMIN=1000
RATE_LIMIT_MAX_REQUESTS_TEACHER=500
RATE_LIMIT_MAX_REQUESTS_STUDENT=100

# Security Headers
ENABLE_STRICT_TRANSPORT_SECURITY=true
ENABLE_CONTENT_SECURITY_POLICY=true

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
ENABLE_AUDIT_LOGGING=true

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@scoreaimanage.onrender.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx

# Session Configuration
SESSION_SECRET=your-session-secret-key-for-production
SESSION_MAX_AGE=86400000

# Development/Production
NODE_ENV=production
PORT=10000

# Redis Configuration (for rate limiting and sessions in production)
REDIS_URL=redis://your-redis-host.render.com:6379
REDIS_PASSWORD=your-redis-password

# Monitoring and Analytics
ENABLE_PERFORMANCE_MONITORING=true
SENTRY_DSN=your-sentry-dsn-for-error-tracking
